+export function feedbackSDKShowStyled(
+  viewMode: feedbackSDKViewMode,
+  title: string | null,
+  titleFontSize: number | null,
+  titleColorHex: string | null,
+  titleFont: string | null,
+  flowId: string | null,
+  language: string | null,
+  customer: Map<string, any> | null,
+  payload: Map<string, string> | null,
+  callback: (status: feedbackSDKCallback | undefined | string) => void
+): void {
+  const viewModeValue: number = viewMode;
+  const titleFontSizeValue = isTurboModuleEnabled
+    ? titleFontSize ?? 0
+    : titleFontSize?.toString();
+  const customerValue = isTurboModuleEnabled
+    ? mapToObject(customer) ?? {}
+    : customer;
+  const payloadValue = isTurboModuleEnabled
+    ? mapToObject(payload) ?? {}
+    : payload;
+
+  // Back-compat: if native doesn’t have showStyled (older versions), fall back to show.
+  const native: any = FeedbackReactNativeSdk as any;
+  const hasShowStyled = typeof native?.showStyled === 'function';
+
+  const nativeCallback = (status: number) => {
+    if (callback != null) {
+      callback(Object.values(feedbackSDKCallback)[status]);
+    }
+  };
+
+  if (hasShowStyled) {
+    native.showStyled(
+      viewModeValue,
+      title,
+      titleFontSizeValue,
+      titleColorHex,
+      titleFont,
+      flowId,
+      language,
+      customerValue,
+      payloadValue,
+      nativeCallback
+    );
+    return;
+  }
+
+  // Fallback: older native versions only support title + fontSize.
+  FeedbackReactNativeSdk.show(
+    viewModeValue,
+    title,
+    titleFontSizeValue,
+    flowId,
+    language,
+    customerValue,
+    payloadValue,
+    nativeCallback
+  );
+}
